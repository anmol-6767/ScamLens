# Frontend (safe to expose: contains no secrets)
VITE_API_URL=/api
VITE_DEMO_MODE=true

# Backend only (NEVER prefix with VITE_)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
PORT=8787
NODE_ENV=development
DB_PATH=./data/skillbridge.sqlite
APP_ORIGIN=http://localhost:5173
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_DEV_LINKS=false

# Required for email verification and password-reset delivery outside local dev-link mode
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
